    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..19
      IDENT@9..14 "where"
      WHITESPACE@14..15 " "
      BIN_EXPR@15..19
        NAME_REF@15..16
          IDENT@15..16 "s"
        WHITESPACE@16..17 " "
        EQ2@17..19 "=="
    WHITESPACE@19..20 " "
    ERROR@20..45
      ERROR@20..23 "“"
      IDENT@23..26 "abc"
      ERROR@26..29 "”"
      WHITESPACE@29..30 " "
      OR_KW@30..32 "or"
      WHITESPACE@32..33 " "
      IDENT@33..34 "s"
      WHITESPACE@34..35 " "
      EQ2@35..37 "=="
      WHITESPACE@37..38 " "
      ERROR@38..41 "‘"
      IDENT@41..42 "x"
      ERROR@42..45 "’"
  WHITESPACE@45..46 "\n"

