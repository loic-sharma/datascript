# Line and block comments are trivia.
mode: syntax
---- query
from t // to end of line
/* block
   comment */ | take 1
---- expected
PROGRAM@0..57
  PIPELINE@0..56
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    LINE_COMMENT@7..24 "// to end of line"
    WHITESPACE@24..25 "\n"
    BLOCK_COMMENT@25..47 "/* block\n   comment */"
    WHITESPACE@47..48 " "
    PIPE@48..49 "|"
    WHITESPACE@49..50 " "
    TAKE_OP@50..56
      IDENT@50..54 "take"
      WHITESPACE@54..55 " "
      LITERAL@55..56
        LONG@55..56 "1"
  WHITESPACE@56..57 "\n"
