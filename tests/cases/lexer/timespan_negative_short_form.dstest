# `timespan(...)` takes a sign before a short-form body too.
mode: syntax
---- query
from t | where d > timespan(-90m) and d < timespan(-01:30)
---- expected
PROGRAM@0..59
  PIPELINE@0..58
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..58
      IDENT@9..14 "where"
      WHITESPACE@14..15 " "
      BIN_EXPR@15..58
        BIN_EXPR@15..33
          NAME_REF@15..16
            IDENT@15..16 "d"
          WHITESPACE@16..17 " "
          GT@17..18 ">"
          WHITESPACE@18..19 " "
          LITERAL@19..33
            TIMESPAN@19..33 "timespan(-90m)"
        WHITESPACE@33..34 " "
        AND_KW@34..37 "and"
        WHITESPACE@37..38 " "
        BIN_EXPR@38..58
          NAME_REF@38..39
            IDENT@38..39 "d"
          WHITESPACE@39..40 " "
          LT@40..41 "<"
          WHITESPACE@41..42 " "
          LITERAL@42..58
            TIMESPAN@42..58 "timespan(-01:30)"
  WHITESPACE@58..59 "\n"
