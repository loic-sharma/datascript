# `timespan(...)` takes a sign before a short-form body too.
mode: syntax
---- query
t | where d > timespan(-90m) and d < timespan(-01:30)
---- expected
PROGRAM@0..54
  PIPELINE@0..53
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    WHERE_OP@4..53
      IDENT@4..9 "where"
      WHITESPACE@9..10 " "
      BIN_EXPR@10..53
        BIN_EXPR@10..28
          NAME_REF@10..11
            IDENT@10..11 "d"
          WHITESPACE@11..12 " "
          GT@12..13 ">"
          WHITESPACE@13..14 " "
          LITERAL@14..28
            TIMESPAN@14..28 "timespan(-90m)"
        WHITESPACE@28..29 " "
        AND_KW@29..32 "and"
        WHITESPACE@32..33 " "
        BIN_EXPR@33..53
          NAME_REF@33..34
            IDENT@33..34 "d"
          WHITESPACE@34..35 " "
          LT@35..36 "<"
          WHITESPACE@36..37 " "
          LITERAL@37..53
            TIMESPAN@37..53 "timespan(-01:30)"
  WHITESPACE@53..54 "\n"
