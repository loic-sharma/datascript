# CRLF line endings: an unterminated string, a line comment and an unclosed `datetime(` each end
# before the `\r\n`.
mode: syntax
eol: crlf
---- query
t | where s == 'abc
// a comment
| where d > datetime(2024-01-01
| take 1
---- expected
PROGRAM@0..78
  PIPELINE@0..76
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    WHERE_OP@4..19
      IDENT@4..9 "where"
      WHITESPACE@9..10 " "
      BIN_EXPR@10..19
        NAME_REF@10..11
          IDENT@10..11 "s"
        WHITESPACE@11..12 " "
        EQ2@12..14 "=="
        WHITESPACE@14..15 " "
        LITERAL@15..19
          STRING@15..19 "'abc"
    WHITESPACE@19..21 "\r\n"
    LINE_COMMENT@21..33 "// a comment"
    WHITESPACE@33..35 "\r\n"
    PIPE@35..36 "|"
    WHITESPACE@36..37 " "
    WHERE_OP@37..66
      IDENT@37..42 "where"
      WHITESPACE@42..43 " "
      BIN_EXPR@43..66
        NAME_REF@43..44
          IDENT@43..44 "d"
        WHITESPACE@44..45 " "
        GT@45..46 ">"
        WHITESPACE@46..47 " "
        LITERAL@47..66
          DATETIME@47..66 "datetime(2024-01-01"
    WHITESPACE@66..68 "\r\n"
    PIPE@68..69 "|"
    WHITESPACE@69..70 " "
    TAKE_OP@70..76
