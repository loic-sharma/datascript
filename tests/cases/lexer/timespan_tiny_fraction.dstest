# Fraction digits past nanosecond precision are dropped: a tiny timespan is zero, not "too large".
mode: syntax
---- query
t | where d > 0.0000000000000000000000000000000000000001s
---- expected
PROGRAM@0..58
  PIPELINE@0..57
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    WHERE_OP@4..57
      IDENT@4..9 "where"
      WHITESPACE@9..10 " "
      BIN_EXPR@10..57
        NAME_REF@10..11
          IDENT@10..11 "d"
        WHITESPACE@11..12 " "
        GT@12..13 ">"
        WHITESPACE@13..14 " "
        LITERAL@14..57
          TIMESPAN@14..57 "0.0000000000000000000000000000000000000001s"
  WHITESPACE@57..58 "\n"
