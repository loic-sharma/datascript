# Greek mu (U+03BC) is accepted for microseconds, like the micro sign (U+00B5).
mode: syntax
---- query
from t | where d > 5μs and d < 5µs
---- expected
PROGRAM@0..37
  PIPELINE@0..36
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..36
      IDENT@9..14 "where"
      WHITESPACE@14..15 " "
      BIN_EXPR@15..36
        BIN_EXPR@15..23
          NAME_REF@15..16
            IDENT@15..16 "d"
          WHITESPACE@16..17 " "
          GT@17..18 ">"
          WHITESPACE@18..19 " "
          LITERAL@19..23
            TIMESPAN@19..23 "5μs"
        WHITESPACE@23..24 " "
        AND_KW@24..27 "and"
        WHITESPACE@27..28 " "
        BIN_EXPR@28..36
          NAME_REF@28..29
            IDENT@28..29 "d"
          WHITESPACE@29..30 " "
          LT@30..31 "<"
          WHITESPACE@31..32 " "
          LITERAL@32..36
            TIMESPAN@32..36 "5µs"
  WHITESPACE@36..37 "\n"
