# Greek mu (U+03BC) is accepted for microseconds, like the micro sign (U+00B5).
mode: syntax
---- query
t | where d > 5μs and d < 5µs
---- expected
PROGRAM@0..32
  PIPELINE@0..31
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    WHERE_OP@4..31
      IDENT@4..9 "where"
      WHITESPACE@9..10 " "
      BIN_EXPR@10..31
        BIN_EXPR@10..18
          NAME_REF@10..11
            IDENT@10..11 "d"
          WHITESPACE@11..12 " "
          GT@12..13 ">"
          WHITESPACE@13..14 " "
          LITERAL@14..18
            TIMESPAN@14..18 "5μs"
        WHITESPACE@18..19 " "
        AND_KW@19..22 "and"
        WHITESPACE@22..23 " "
        BIN_EXPR@23..31
          NAME_REF@23..24
            IDENT@23..24 "d"
          WHITESPACE@24..25 " "
          LT@25..26 "<"
          WHITESPACE@26..27 " "
          LITERAL@27..31
            TIMESPAN@27..31 "5µs"
  WHITESPACE@31..32 "\n"
