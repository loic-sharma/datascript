# Number and timespan literal edge cases, one statement each.
mode: syntax
---- query
from 1e3s;
from 1_;
from timespan(1.25:00);
from timespan(:)
---- expected
PROGRAM@0..61
  PIPELINE@0..9
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    LITERAL@5..9
      TIMESPAN@5..9 "1e3s"
  SEMICOLON@9..10 ";"
  WHITESPACE@10..11 "\n"
  PIPELINE@11..18
    IDENT@11..15 "from"
    WHITESPACE@15..16 " "
    LITERAL@16..18
      LONG@16..18 "1_"
  SEMICOLON@18..19 ";"
  WHITESPACE@19..20 "\n"
  PIPELINE@20..42
    IDENT@20..24 "from"
    WHITESPACE@24..25 " "
    LITERAL@25..42
      TIMESPAN@25..42 "timespan(1.25:00)"
  SEMICOLON@42..43 ";"
  WHITESPACE@43..44 "\n"
  PIPELINE@44..60
    IDENT@44..48 "from"
    WHITESPACE@48..49 " "
    LITERAL@49..60
      TIMESPAN@49..60 "timespan(:)"
  WHITESPACE@60..61 "\n"

error[DS0003]: a timespan cannot use an exponent
  --> query:1:6
  |
1 | from 1e3s;
  |      ^^^^ exponent used in a timespan
  |
  = help: write the number out in full, or use a larger unit

error[DS0003]: invalid number `1_`
  --> query:2:7
  |
2 | from 1_;
  |       ^ `_` must be between two digits
  |
  = help: remove it: `1`

error[DS0003]: invalid timespan `1.25:00`
  --> query:3:17
  |
3 | from timespan(1.25:00);
  |                 ^^ hours must be 0 to 23
  |
  = help: write `[days.]hours:minutes[:seconds]`, e.g. `timespan(1.02:03:04)`

error[DS0003]: invalid timespan `:`
  --> query:4:15
  |
4 | from timespan(:)
  |               ^ expected hours
  |
  = help: write `[days.]hours:minutes[:seconds]`, e.g. `timespan(1.02:03:04)`
