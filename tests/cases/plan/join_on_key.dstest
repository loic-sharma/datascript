# `join ... on key` is an equi-join on a renamed right key, then a `Project` that keeps one key
# column in the left column's place (D-019): the left value, the right one for `rightouter`,
# `coalesce` for `fullouter`.
mode: explain
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, timestamp: datetime); 'customers.csv'(customerId: string, name: string, region: string)
---- query
from 'orders.csv' | join 'customers.csv' on customerId;
from 'orders.csv' | join kind = rightouter 'customers.csv' on customerId;
from 'orders.csv' | join kind = fullouter 'customers.csv' on customerId
---- expected
Project: orderId, customerId, amount, qty, timestamp, name, region
  Join: inner on customerId == customerId1
    Scan: 'orders.csv' (orderId: string, customerId: string, amount: real, qty: long, timestamp: datetime)
    Project: customerId1 = customerId, name, region
      Scan: 'customers.csv' (customerId: string, name: string, region: string)

Project: orderId, customerId = customerId1, amount, qty, timestamp, name, region
  Join: rightouter on customerId == customerId1
    Scan: 'orders.csv' (orderId: string, customerId: string, amount: real, qty: long, timestamp: datetime)
    Project: customerId1 = customerId, name, region
      Scan: 'customers.csv' (customerId: string, name: string, region: string)

Project: orderId, customerId = coalesce(customerId, customerId1), amount, qty, timestamp, name, region
  Join: fullouter on customerId == customerId1
    Scan: 'orders.csv' (orderId: string, customerId: string, amount: real, qty: long, timestamp: datetime)
    Project: customerId1 = customerId, name, region
      Scan: 'customers.csv' (customerId: string, name: string, region: string)
