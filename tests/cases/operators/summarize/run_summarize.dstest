# `summarize` with expression keys, unnamed aggregates, an item computed over aggregates (D-042),
# and keys only.
mode: run
---- query
from '../../../data/orders.csv'
| summarize revenue = sum(amount), avg_ = sum(amount) / count(), count() by month = startofmonth(timestamp)
| sort by month asc;
from '../../../data/orders.csv'
| where customerId in ('c-001', 'c-019')
| summarize by customerId
| sort by customerId asc
