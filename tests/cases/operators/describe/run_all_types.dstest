# `describe` over a Parquet file with every M1 DataScript type (`bool`, `int`, `long`, `real`,
# `string`, `datetime`, `timespan`) plus unsupported Arrow columns (`Binary` and `arrow.json`,
# which get only `count` and `null_percentage`).
mode: run
---- query
from '../../../data/all_types.parquet'
| extend small = toint(whole)
| describe;

from '../../../data/json/poly.ndjson'
| describe
