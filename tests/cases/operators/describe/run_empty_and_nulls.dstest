# `describe` on empty tables (0 rows: `null_percentage` is null, `count` and `approx_unique` are 0),
# an all-null column (`null_percentage` is 100.0), a single-column all-null `real` table, and a
# single-row numeric column (`std` is null for fewer than 2 non-null values).
mode: run
---- query
from '../../../data/edge/header_only.csv' | describe;

from '../../../data/orders.csv' | take 0 | describe;

from '../../../data/edge/nulls.csv' | describe;

from '../../../data/orders.csv' | where isnull(amount) | project amount | describe;

from '../../../data/orders.csv' | take 1 | project amount | describe
