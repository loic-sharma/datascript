# `sort` and `top` keep the columns.
mode: check
show: schema
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, timestamp: datetime)
---- query
from 'orders.csv' | sort by amount desc, orderId asc nulls last;
from 'orders.csv' | top 3 by amount
---- expected
query 1 columns:
  orderId: string
  customerId: string
  amount: real
  qty: long
  timestamp: datetime

query 2 columns:
  orderId: string
  customerId: string
  amount: real
  qty: long
  timestamp: datetime
