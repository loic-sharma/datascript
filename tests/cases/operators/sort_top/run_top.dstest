# `top` defaults to descending and sorts on expressions; `order by` is `sort by`.
mode: run
---- query
from '../../../data/orders.csv'
| top 3 by amount
| project orderId, amount;
from '../../../data/orders.csv'
| top 2 by strcat('x', orderId) asc
| project orderId;
from '../../../data/customers.csv'
| order by name asc
| take 2
| project name
