# A null key matches nothing, not even another null (LANGUAGE.md §3.2, `join`). `edge/nulls.csv` has a
# null `name` in rows 2 and 5; `b` holds rows 2–5, so both sides have null keys. Inner and semi
# joins drop the null-key rows, outer joins keep them unmatched (in `fullouter`, `b`'s two null
# rows come out on their own), and anti joins keep them. The last query checks the same for a
# `$left.k == $right.k` condition, which keeps both key columns (the right one renamed, DS1007).
mode: run
---- query
let a = from '../../../data/edge/nulls.csv' | project id, k = name;
let b = from '../../../data/edge/nulls.csv' | where id != 1 | project k = name, bid = id;
from a | join b on k | sort by id asc;
from a | join kind = leftouter b on k | sort by id asc;
from a | join kind = rightouter b on k | sort by bid asc;
from a | join kind = fullouter b on k | sort by id asc, bid asc;
from a | join kind = leftsemi b on k | sort by id asc;
from a | join kind = leftanti b on k | sort by id asc;
from a | join kind = rightsemi b on k | sort by bid asc;
from a | join kind = rightanti b on k | sort by bid asc;
from a | join b on $left.k == $right.k | sort by id asc
---- expected
info[DS1007]: `join` renamed column `k` of the right table to `k1`
   --> query:11:15
   |
11 | from a | join b on $left.k == $right.k | sort by id asc
   |               ^ this table also has a column `k`
   |
   = help: to choose the names yourself, rename them on the right: `join (from b | project-rename right_k = k)`
   = note: a column named in `on` is not renamed: the two sides make one column (only `$left.a == $right.b` keeps both)

