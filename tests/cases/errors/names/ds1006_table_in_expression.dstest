# A tabular `let` used as a value is DS1006.
mode: check
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
let big = from 'orders.csv';
from 'orders.csv' | where amount > big
---- expected
error[DS1006]: `big` is a table, not a value
  --> query:2:36
  |
2 | from 'orders.csv' | where amount > big
  |                                    ^^^ this names a table
  |
  = note: a table can be read with `from`, or joined with `join`
