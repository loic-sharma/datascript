# `describe` takes no arguments (DS0290), and recovers so later errors in the same pipeline still
# appear.
mode: syntax
---- query
from 'orders.csv' | describe amount;
from 'orders.csv' | describe orderId, amount | where count = 1;
from 'orders.csv' | describe 'orders.csv';
from 'orders.csv' | describe read_csv('orders.csv')
