      MINUS@22..23 "-"
      IDENT@23..29 "rename"
      WHITESPACE@29..30 " "
      RENAME_ITEM@30..44
        NAME@30..35
          FALSE_KW@30..35 "false"
        WHITESPACE@35..36 " "
        EQ@36..37 "="
        WHITESPACE@37..38 " "
        NAME_REF@38..44
          IDENT@38..44 "amount"
    WHITESPACE@44..45 " "
    PIPE@45..46 "|"
    WHITESPACE@46..47 " "
    EXTEND_OP@47..68
      IDENT@47..53 "extend"
      WHITESPACE@53..54 " "
      NAMED_EXPR@54..68
        NAME@54..55
          IDENT@54..55 "x"
        WHITESPACE@55..56 " "
