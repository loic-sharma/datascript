# A table whose name is an operator, used alone, is a table: no DS0125.
mode: syntax
---- query
from count;
from take | count
---- expected
PROGRAM@0..30
  PIPELINE@0..10
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..10
      IDENT@5..10 "count"
  SEMICOLON@10..11 ";"
  WHITESPACE@11..12 "\n"
  PIPELINE@12..29
    IDENT@12..16 "from"
    WHITESPACE@16..17 " "
    NAME_REF@17..21
      IDENT@17..21 "take"
    WHITESPACE@21..22 " "
    PIPE@22..23 "|"
    WHITESPACE@23..24 " "
    COUNT_OP@24..29
      IDENT@24..29 "count"
  WHITESPACE@29..30 "\n"
