# Each SQL join written as an operator gets the matching `join kind`; `CROSS JOIN` has none.
mode: syntax
---- query
from 'a.csv' | inner join 'b.csv' on k;
from 'a.csv' | FULL OUTER JOIN 'b.csv' on k;
from 'a.csv' | right join 'b.csv' on k;
from 'a.csv' | LEFT ANTI JOIN 'b.csv' on k;
from 'a.csv' | CROSS JOIN 'b.csv'
