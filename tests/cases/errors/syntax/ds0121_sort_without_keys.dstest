      STRING@5..17 "'orders.csv'"
    WHITESPACE@17..18 " "
    PIPE@18..19 "|"
    WHITESPACE@19..20 " "
    SORT_OP@20..24
      IDENT@20..24 "sort"
  WHITESPACE@24..25 "\n"

error[DS0121]: missing `by` after `sort`
