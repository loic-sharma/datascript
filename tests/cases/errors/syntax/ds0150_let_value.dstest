# A `let` value that is a pipeline without `from`, or a reader call alone: DS0150 with a machine-applicable fix.
mode: syntax
---- query
let a = orders | where amount > 1;
let b = 'orders.csv' | take 1;
let c = read_csv('x.txt') | take 1;
let r = read_csv('x.txt');
from a | union b, c, r
