          NAME_REF@28..29
            IDENT@28..29 "a"
          WHITESPACE@29..30 " "
          GT@30..31 ">"
          WHITESPACE@31..32 " "
          LITERAL@32..33
            LONG@32..33 "1"
  SEMICOLON@33..34 ";"
