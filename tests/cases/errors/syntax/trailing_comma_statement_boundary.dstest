# Statement boundaries after a trailing comma recover as DS0106, while `let = 1` stays DS0126.
mode: syntax
---- query
from 'a.csv' | project a,
from 'b.csv';
from 'a.csv' | project a,
let x = 1;
from 'a.csv' | project a, let = 1
---- expected
PROGRAM@0..111
  PIPELINE@0..25
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    LITERAL@5..12
      STRING@5..12 "'a.csv'"
    WHITESPACE@12..13 " "
    PIPE@13..14 "|"
    WHITESPACE@14..15 " "
    PROJECT_OP@15..25
      IDENT@15..22 "project"
      WHITESPACE@22..23 " "
      NAMED_EXPR@23..24
        NAME_REF@23..24
          IDENT@23..24 "a"
      COMMA@24..25 ","
  WHITESPACE@25..26 "\n"
  PIPELINE@26..38
    IDENT@26..30 "from"
    WHITESPACE@30..31 " "
    LITERAL@31..38
      STRING@31..38 "'b.csv'"
  SEMICOLON@38..39 ";"
  WHITESPACE@39..40 "\n"
  PIPELINE@40..65
    IDENT@40..44 "from"
    WHITESPACE@44..45 " "
