      STRING@45..52 "'a.csv'"
    WHITESPACE@52..53 " "
    PIPE@53..54 "|"
    WHITESPACE@54..55 " "
    PROJECT_OP@55..65
      IDENT@55..62 "project"
      WHITESPACE@62..63 " "
      NAMED_EXPR@63..64
        NAME_REF@63..64
          IDENT@63..64 "a"
      COMMA@64..65 ","
  WHITESPACE@65..66 "\n"
  LET_STMT@66..75
    LET_KW@66..69 "let"
    WHITESPACE@69..70 " "
    NAME@70..71
      IDENT@70..71 "x"
    WHITESPACE@71..72 " "
    EQ@72..73 "="
    WHITESPACE@73..74 " "
    LITERAL@74..75
      LONG@74..75 "1"
  SEMICOLON@75..76 ";"
  WHITESPACE@76..77 "\n"
  PIPELINE@77..110
    IDENT@77..81 "from"
    WHITESPACE@81..82 " "
    LITERAL@82..89
      STRING@82..89 "'a.csv'"
    WHITESPACE@89..90 " "
    PIPE@90..91 "|"
    WHITESPACE@91..92 " "
    PROJECT_OP@92..110
      IDENT@92..99 "project"
      WHITESPACE@99..100 " "
      NAMED_EXPR@100..101
        NAME_REF@100..101
          IDENT@100..101 "a"
      COMMA@101..102 ","
      WHITESPACE@102..103 " "
      NAMED_EXPR@103..110
        NAME@103..106
          LET_KW@103..106 "let"
        WHITESPACE@106..107 " "
        EQ@107..108 "="
        WHITESPACE@108..109 " "
