# Statement boundaries after a trailing comma recover as DS0106, while reserved-word `let` stays DS0126.
mode: syntax
---- query
from 'a.csv' | project a,
from 'b.csv';
from 'a.csv' | project a,
let x = 1;
from 'a.csv' | project a, let = 1;
from 'a.csv' | project-away a, let | take 5;
from 'a.csv' | project-away a, let
---- expected
PROGRAM@0..192
  PIPELINE@0..25
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
