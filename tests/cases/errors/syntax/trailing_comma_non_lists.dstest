# Non-list constructs reject trailing or extra commas with their expected diagnostic codes.
mode: syntax
---- query
from t | where a, b;
from t | where a,;
from t | top 5 by amount desc,;
from t | take 5,;
from t | where a between (1 .. 10,);
from t | extend x = (a,);
from t | extend x = a[0,];
from t | distinct *,;
from t | project *, | take 5;
from t | extend x = long(null,);
from t | extend x = long(null,,);
from t | distinct *,
---- expected
