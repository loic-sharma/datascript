# Math functions on `int` give a `long`, like `int` arithmetic (D-021), as the errors show.
mode: check
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
from 'orders.csv' | where abs(small) == "x";
from 'orders.csv' | where round(toint(-2147483648)) == "x";
from 'orders.csv' | where bin(small, 10) == "x"
---- expected
error[DS2003]: cannot compare `long` with `string`
  --> query:1:27
  |
1 | from 'orders.csv' | where abs(small) == "x";
  |                           ^^^^^^^^^^    --- this is `string`
  |                           |
  |                           this is `long`
  |
  = help: convert the string first, e.g. `abs(small) == tolong("x")`, or convert the other side with `tostring()`

error[DS2003]: cannot compare `long` with `string`
  --> query:2:27
  |
2 | from 'orders.csv' | where round(toint(-2147483648)) == "x";
  |                           ^^^^^^^^^^^^^^^^^^^^^^^^^    --- this is `string`
  |                           |
  |                           this is `long`
  |
  = help: convert the string first, e.g. `round(toint(-2147483648)) == tolong("x")`, or convert the other side with `tostring()`

error[DS2003]: cannot compare `long` with `string`
  --> query:3:27
  |
3 | from 'orders.csv' | where bin(small, 10) == "x"
  |                           ^^^^^^^^^^^^^^    --- this is `string`
  |                           |
  |                           this is `long`
  |
  = help: convert the string first, e.g. `bin(small, 10) == tolong("x")`, or convert the other side with `tostring()`
