# Wrong number of arguments: extra ones are underlined, missing ones named.
mode: check
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
from 'orders.csv' | where strlen(orderId, 1) > 0;
from 'orders.csv' | where substring(orderId) == "x"
---- expected
error[DS2002]: `strlen` takes 1 argument, found 2
  --> query:1:43
  |
1 | from 'orders.csv' | where strlen(orderId, 1) > 0;
  |                                           ^ this argument is not expected
  |
  = note: signature: `strlen(source: string) -> long`

error[DS2002]: `substring` takes 2 or 3 arguments, found 1
  --> query:2:27
  |
2 | from 'orders.csv' | where substring(orderId) == "x"
  |                           ^^^^^^^^^^^^^^^^^^ missing `start`
  |
  = note: signature: `substring(source: string, start: integer[, length: integer]) -> string`
