# Arithmetic, comparisons and logic type-check against the operator table (LANGUAGE.md §4.1).
mode: check
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
from 'orders.csv'
| where (amount * 2 + qty) / 3 > 10 and not shipped or orderId == "o-1"
| where qty % 2 == 0 and -amount < 0 and small * small >= 1
---- expected
