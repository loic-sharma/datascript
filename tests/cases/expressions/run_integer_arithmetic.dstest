# Integer arithmetic gives `long`; `/` truncates toward zero and `%` takes the dividend's sign
# (D-014). `int` operands widen.
mode: run
---- query
from '../../data/orders.csv'
| where orderId == 'o-0001'
| project a = -7 / 2, b = 7 / -2, c = -7 % 2, d = 7 % -3, e = 2 * 3 + 4 - 1, f = toint(5) * toint(7), g = 9223372036854775807 - 1, h = -9223372036854775807 - 1, i = -tolong(5)
---- expected
a    | b    | c    | d    | e    | f    | g                   | h                    | i
long | long | long | long | long | long | long                | long                 | long
-----+------+------+------+------+------+---------------------+----------------------+-----
  -3 |   -3 |   -1 |    1 |    9 |   35 | 9223372036854775806 | -9223372036854775808 |   -5
