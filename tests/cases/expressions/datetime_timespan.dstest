# Datetime and timespan literals and arithmetic.
mode: check
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
from 'orders.csv'
| where timestamp > datetime(2024-01-01) + 1d and wait < 2h
| where timestamp - datetime(2024-01-01T12:00:00Z) > timespan(1.00:00:00) and wait * 2 <= 90m
---- expected
