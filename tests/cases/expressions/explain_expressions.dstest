# The plan shows the conversions the binder inserts: `int` arithmetic is `long` (D-021).
mode: explain
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
from 'orders.csv'
| where small * small > 3 and qty + 1.5 > amount and wait <= 90m
| where timestamp >= datetime(2024-01-31) and qty in (1, 2.5) and -qty < 0 and string(null) == orderId
---- expected
Filter: (((timestamp >= datetime(2024-01-31T00:00:00Z)) and (cast(qty, real) in (1.0, 2.5))) and ((-qty) < 0)) and (string(null) == orderId)
  Filter: (((cast(small, long) * cast(small, long)) > 3) and ((cast(qty, real) + 1.5) > amount)) and (wait <= 90m)
    Scan: 'orders.csv' (orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
