# `in`, `!in~` and `between` with widening between `long` and `real`.
mode: check
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
from 'orders.csv'
| where customerId in ("c-1", "c-2") and orderId !in~ ("O-9")
| where qty between (1 .. 10.5) and amount !between (0 .. 1)
---- expected
