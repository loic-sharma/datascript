# Typed nulls, and untyped `null` taking its type from the other operand.
mode: check
schema: 'orders.csv'(orderId: string, customerId: string, amount: real, qty: long, small: int, timestamp: datetime, wait: timespan, shipped: bool)
---- query
from 'orders.csv'
| where qty != long(null) and isnull(string(null)) and amount > null
| where coalesce(customerId, null) != "" and null
---- expected
