# Optional trailing commas in operator lists before `|`, `;`, `)`, and EOF.
mode: syntax
---- query
from t
| project a, b = a + 1,
| extend c = b * 2,
| project-away a,
| project-rename d = b,
| distinct c, d,
| sort by d desc,
| order by c asc,
| join u on d,
| union v, w,;
(from t | project a,) | sort by a asc,
