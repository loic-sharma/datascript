# Scalar and tabular lets produce the same LET_STMT node; a query statement is a PIPELINE.
mode: syntax
---- query
let threshold = 100;
let big = from 'orders.csv' | where amount > threshold;
from big | count;
---- expected
PROGRAM@0..95
  LET_STMT@0..19
    LET_KW@0..3 "let"
    WHITESPACE@3..4 " "
    NAME@4..13
      IDENT@4..13 "threshold"
    WHITESPACE@13..14 " "
    EQ@14..15 "="
    WHITESPACE@15..16 " "
    LITERAL@16..19
      LONG@16..19 "100"
  SEMICOLON@19..20 ";"
  WHITESPACE@20..21 "\n"
  LET_STMT@21..75
    LET_KW@21..24 "let"
    WHITESPACE@24..25 " "
    NAME@25..28
      IDENT@25..28 "big"
    WHITESPACE@28..29 " "
    EQ@29..30 "="
    WHITESPACE@30..31 " "
    PIPELINE@31..75
      IDENT@31..35 "from"
      WHITESPACE@35..36 " "
      LITERAL@36..48
        STRING@36..48 "'orders.csv'"
      WHITESPACE@48..49 " "
      PIPE@49..50 "|"
      WHITESPACE@50..51 " "
      WHERE_OP@51..75
        IDENT@51..56 "where"
        WHITESPACE@56..57 " "
        BIN_EXPR@57..75
          NAME_REF@57..63
            IDENT@57..63 "amount"
          WHITESPACE@63..64 " "
          GT@64..65 ">"
          WHITESPACE@65..66 " "
          NAME_REF@66..75
            IDENT@66..75 "threshold"
  SEMICOLON@75..76 ";"
  WHITESPACE@76..77 "\n"
  PIPELINE@77..93
    IDENT@77..81 "from"
    WHITESPACE@81..82 " "
    NAME_REF@82..85
      IDENT@82..85 "big"
    WHITESPACE@85..86 " "
    PIPE@86..87 "|"
    WHITESPACE@87..88 " "
    COUNT_OP@88..93
      IDENT@88..93 "count"
  SEMICOLON@93..94 ";"
  WHITESPACE@94..95 "\n"
