# A stray ) is skipped and the pipeline continues.
mode: syntax
---- query
t | where x) | take 5
---- expected
PROGRAM@0..22
  PIPELINE@0..21
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
