# Optional trailing commas in delimited lists: calls, readers, `in (...)`, and `render ... with (...)`.
mode: syntax
---- query
from read_csv('x.csv', delimiter = ';',)
| where customerId in ('c-001', 'c-042',)
| extend
    label = strcat(customerId, 'a',),
    tier = case(amount > 100, 'high', 'low',),
| render linechart with (title = "Sales",);
from t | render linechart with (ycolumns = a, b,);
from t | render linechart with (ycolumns = a, b, title = "Sales",)
---- expected
PROGRAM@0..339
  PIPELINE@0..219
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    CALL_EXPR@5..40
      NAME_REF@5..13
        IDENT@5..13 "read_csv"
