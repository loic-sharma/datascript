# Multi-line lists with trailing commas, comments, and `from` continuations.
mode: syntax
---- query
from t
| project
    a,
    b, // last item
| summarize
    total = sum(a), /* comment before by */
    by
    b, // last key
| extend
    x = case(
        a > 1, 'big',
        'small', // default branch
    ),;
from t | project a,
b;
from t | project a,
from | take 1;
from t | project a,
from - 1;
from t | extend x = f(a,
from 'b.csv')
