# project-rename takes new = old pairs.
mode: syntax
---- query
from t | project-rename id = orderId, ['the name'] = name
---- expected
PROGRAM@0..58
  PIPELINE@0..57
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    PROJECT_RENAME_OP@9..57
      IDENT@9..16 "project"
      MINUS@16..17 "-"
      IDENT@17..23 "rename"
      WHITESPACE@23..24 " "
      RENAME_ITEM@24..36
        NAME@24..26
          IDENT@24..26 "id"
        WHITESPACE@26..27 " "
        EQ@27..28 "="
        WHITESPACE@28..29 " "
        NAME_REF@29..36
          IDENT@29..36 "orderId"
      COMMA@36..37 ","
      WHITESPACE@37..38 " "
      RENAME_ITEM@38..57
        NAME@38..50
          QUOTED_IDENT@38..50 "['the name']"
        WHITESPACE@50..51 " "
        EQ@51..52 "="
        WHITESPACE@52..53 " "
        NAME_REF@53..57
          IDENT@53..57 "name"
  WHITESPACE@57..58 "\n"
