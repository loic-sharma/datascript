    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..16
      IDENT@9..14 "where"
      WHITESPACE@14..15 " "
      NAME_REF@15..16
        IDENT@15..16 "a"
    WHITESPACE@16..17 " "
    ERROR@17..20
      ERROR@17..18 "#"
      WHITESPACE@18..19 " "
      IDENT@19..20 "b"
    WHITESPACE@20..21 " "
    PIPE@21..22 "|"
    WHITESPACE@22..23 " "
    TAKE_OP@23..29
      IDENT@23..27 "take"
      WHITESPACE@27..28 " "
      LITERAL@28..29
        LONG@28..29 "5"
  WHITESPACE@29..30 "\n"

error[DS0001]: unexpected character `#`
