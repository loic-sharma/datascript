# where with a contextual keyword as a column name (D-013).
mode: syntax
---- query
from t | where order > 3
---- expected
PROGRAM@0..25
  PIPELINE@0..24
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..24
      IDENT@9..14 "where"
      WHITESPACE@14..15 " "
      BIN_EXPR@15..24
        NAME_REF@15..20
          IDENT@15..20 "order"
        WHITESPACE@20..21 " "
        GT@21..22 ">"
        WHITESPACE@22..23 " "
        LITERAL@23..24
          LONG@23..24 "3"
  WHITESPACE@24..25 "\n"
