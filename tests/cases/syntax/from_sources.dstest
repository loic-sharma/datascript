# `from` with each source form: path, glob, name, scalar `let` path, reader call, parenthesized pipeline, `from(`.
mode: syntax
---- query
from 'data/orders.csv' | take 5;
from 'logs/2024-*/*.parquet' | count;
from orders | take 5;
let p = 'data/orders.csv';
from p | take 5;
from read_csv('x.txt', delimiter = ';') | take 5;
from (from orders | where amount > 100) | count;
from('data/orders.csv') | take 1
