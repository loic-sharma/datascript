      PIPELINE@35..46
        IDENT@35..39 "from"
        WHITESPACE@39..40 " "
        NAME_REF@40..46
          IDENT@40..46 "orders"
      R_PAREN@46..47 ")"
    WHITESPACE@47..48 " "
    PIPE@48..49 "|"
    WHITESPACE@49..50 " "
    TAKE_OP@50..56
      IDENT@50..54 "take"
      WHITESPACE@54..55 " "
      LITERAL@55..56
        LONG@55..56 "5"
  SEMICOLON@56..57 ";"
  WHITESPACE@57..58 "\n"
  PIPELINE@58..100
    IDENT@58..62 "from"
    WHITESPACE@62..63 " "
