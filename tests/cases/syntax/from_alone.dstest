      WHITESPACE@25..26 " "
      NAME_REF@26..32
        IDENT@26..32 "orders"
  SEMICOLON@32..33 ";"
  WHITESPACE@33..34 "\n"
  PIPELINE@34..56
    PAREN_EXPR@34..47
