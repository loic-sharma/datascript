# `from x` with no operators is a PIPELINE everywhere: a query, a `let` value, in parentheses, a call argument.
mode: syntax
---- query
from orders;
let t = from orders;
(from orders) | take 5;
from orders | extend n = f(from customers)
---- expected
PROGRAM@0..101
  PIPELINE@0..11
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..11
      IDENT@5..11 "orders"
  SEMICOLON@11..12 ";"
  WHITESPACE@12..13 "\n"
  LET_STMT@13..32
    LET_KW@13..16 "let"
    WHITESPACE@16..17 " "
    NAME@17..18
      IDENT@17..18 "t"
    WHITESPACE@18..19 " "
    EQ@19..20 "="
    WHITESPACE@20..21 " "
    PIPELINE@21..32
