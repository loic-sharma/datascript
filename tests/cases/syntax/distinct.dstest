# distinct with columns, and distinct *.
mode: syntax
---- query
t | distinct a, b | distinct *
---- expected
PROGRAM@0..31
  PIPELINE@0..30
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    DISTINCT_OP@4..17
      IDENT@4..12 "distinct"
      WHITESPACE@12..13 " "
      NAME_REF@13..14
        IDENT@13..14 "a"
      COMMA@14..15 ","
      WHITESPACE@15..16 " "
      NAME_REF@16..17
        IDENT@16..17 "b"
    WHITESPACE@17..18 " "
    PIPE@18..19 "|"
    WHITESPACE@19..20 " "
    DISTINCT_OP@20..30
      IDENT@20..28 "distinct"
      WHITESPACE@28..29 " "
      STAR@29..30 "*"
  WHITESPACE@30..31 "\n"
