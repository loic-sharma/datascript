# distinct with columns, and distinct *.
mode: syntax
---- query
from t | distinct a, b | distinct *
---- expected
PROGRAM@0..36
  PIPELINE@0..35
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    DISTINCT_OP@9..22
      IDENT@9..17 "distinct"
      WHITESPACE@17..18 " "
      NAME_REF@18..19
        IDENT@18..19 "a"
      COMMA@19..20 ","
      WHITESPACE@20..21 " "
      NAME_REF@21..22
        IDENT@21..22 "b"
    WHITESPACE@22..23 " "
    PIPE@23..24 "|"
    WHITESPACE@24..25 " "
    DISTINCT_OP@25..35
      IDENT@25..33 "distinct"
      WHITESPACE@33..34 " "
      STAR@34..35 "*"
  WHITESPACE@35..36 "\n"
