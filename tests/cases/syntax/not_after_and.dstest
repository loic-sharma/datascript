# `not` after `and` is fine (M1-19).
mode: syntax
---- query
from T | where a and not b == c
---- expected
PROGRAM@0..32
  PIPELINE@0..31
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "T"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..31
      IDENT@9..14 "where"
      WHITESPACE@14..15 " "
      BIN_EXPR@15..31
        NAME_REF@15..16
          IDENT@15..16 "a"
        WHITESPACE@16..17 " "
        AND_KW@17..20 "and"
        WHITESPACE@20..21 " "
        PREFIX_EXPR@21..31
          NOT_KW@21..24 "not"
          WHITESPACE@24..25 " "
          BIN_EXPR@25..31
            NAME_REF@25..26
              IDENT@25..26 "b"
            WHITESPACE@26..27 " "
            EQ2@27..29 "=="
            WHITESPACE@29..30 " "
            NAME_REF@30..31
              IDENT@30..31 "c"
  WHITESPACE@31..32 "\n"
