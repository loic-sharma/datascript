# between and !between take a parenthesized range.
mode: syntax
---- query
t | where x between (1 .. 10) and y !between (a + 1 .. b)
---- expected
PROGRAM@0..58
  PIPELINE@0..57
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    WHERE_OP@4..57
      IDENT@4..9 "where"
      WHITESPACE@9..10 " "
      BIN_EXPR@10..57
        BETWEEN_EXPR@10..29
          NAME_REF@10..11
            IDENT@10..11 "x"
          WHITESPACE@11..12 " "
          IDENT@12..19 "between"
          WHITESPACE@19..20 " "
          L_PAREN@20..21 "("
          LITERAL@21..22
            LONG@21..22 "1"
          WHITESPACE@22..23 " "
          DOT2@23..25 ".."
          WHITESPACE@25..26 " "
          LITERAL@26..28
            LONG@26..28 "10"
          R_PAREN@28..29 ")"
        WHITESPACE@29..30 " "
        AND_KW@30..33 "and"
        WHITESPACE@33..34 " "
        BETWEEN_EXPR@34..57
          NAME_REF@34..35
            IDENT@34..35 "y"
          WHITESPACE@35..36 " "
          NEGATED_OP@36..44 "!between"
          WHITESPACE@44..45 " "
          L_PAREN@45..46 "("
          BIN_EXPR@46..51
            NAME_REF@46..47
              IDENT@46..47 "a"
            WHITESPACE@47..48 " "
            PLUS@48..49 "+"
            WHITESPACE@49..50 " "
            LITERAL@50..51
              LONG@50..51 "1"
          WHITESPACE@51..52 " "
          DOT2@52..54 ".."
          WHITESPACE@54..55 " "
          NAME_REF@55..56
            IDENT@55..56 "b"
          R_PAREN@56..57 ")"
  WHITESPACE@57..58 "\n"
