# between and !between take a parenthesized range.
mode: syntax
---- query
from t | where x between (1 .. 10) and y !between (a + 1 .. b)
---- expected
PROGRAM@0..63
  PIPELINE@0..62
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..62
      IDENT@9..14 "where"
      WHITESPACE@14..15 " "
      BIN_EXPR@15..62
        BETWEEN_EXPR@15..34
          NAME_REF@15..16
            IDENT@15..16 "x"
          WHITESPACE@16..17 " "
          IDENT@17..24 "between"
          WHITESPACE@24..25 " "
          L_PAREN@25..26 "("
          LITERAL@26..27
            LONG@26..27 "1"
          WHITESPACE@27..28 " "
          DOT2@28..30 ".."
          WHITESPACE@30..31 " "
          LITERAL@31..33
            LONG@31..33 "10"
          R_PAREN@33..34 ")"
        WHITESPACE@34..35 " "
        AND_KW@35..38 "and"
        WHITESPACE@38..39 " "
        BETWEEN_EXPR@39..62
          NAME_REF@39..40
            IDENT@39..40 "y"
          WHITESPACE@40..41 " "
          NEGATED_OP@41..49 "!between"
          WHITESPACE@49..50 " "
          L_PAREN@50..51 "("
          BIN_EXPR@51..56
            NAME_REF@51..52
              IDENT@51..52 "a"
            WHITESPACE@52..53 " "
            PLUS@53..54 "+"
            WHITESPACE@54..55 " "
            LITERAL@55..56
              LONG@55..56 "1"
          WHITESPACE@56..57 " "
          DOT2@57..59 ".."
          WHITESPACE@59..60 " "
          NAME_REF@60..61
            IDENT@60..61 "b"
          R_PAREN@61..62 ")"
  WHITESPACE@62..63 "\n"
