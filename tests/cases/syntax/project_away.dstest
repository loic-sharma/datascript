# project-away is joined from adjacent tokens (D-026) and accepts wildcards.
mode: syntax
---- query
t | project-away x, tmp*, *_id
---- expected
PROGRAM@0..31
  PIPELINE@0..30
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    PROJECT_AWAY_OP@4..30
      IDENT@4..11 "project"
      MINUS@11..12 "-"
      IDENT@12..16 "away"
      WHITESPACE@16..17 " "
      COLUMN_PATTERN@17..18
        IDENT@17..18 "x"
      COMMA@18..19 ","
      WHITESPACE@19..20 " "
      COLUMN_PATTERN@20..24
        IDENT@20..23 "tmp"
        STAR@23..24 "*"
      COMMA@24..25 ","
      WHITESPACE@25..26 " "
      COLUMN_PATTERN@26..30
        STAR@26..27 "*"
        IDENT@27..30 "_id"
  WHITESPACE@30..31 "\n"
