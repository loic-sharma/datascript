# project-away is joined from adjacent tokens (D-026) and accepts wildcards.
mode: syntax
---- query
from t | project-away x, tmp*, *_id
---- expected
PROGRAM@0..36
  PIPELINE@0..35
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    PROJECT_AWAY_OP@9..35
      IDENT@9..16 "project"
      MINUS@16..17 "-"
      IDENT@17..21 "away"
      WHITESPACE@21..22 " "
      COLUMN_PATTERN@22..23
        IDENT@22..23 "x"
      COMMA@23..24 ","
      WHITESPACE@24..25 " "
      COLUMN_PATTERN@25..29
        IDENT@25..28 "tmp"
        STAR@28..29 "*"
      COMMA@29..30 ","
      WHITESPACE@30..31 " "
      COLUMN_PATTERN@31..35
        STAR@31..32 "*"
        IDENT@32..35 "_id"
  WHITESPACE@35..36 "\n"
