        WHITESPACE@13..14 " "
        IDENT@14..18 "desc"
        WHITESPACE@18..19 " "
        IDENT@19..24 "nulls"
        WHITESPACE@24..25 " "
        IDENT@25..29 "last"
      COMMA@29..30 ","
      WHITESPACE@30..31 " "
