# Optional trailing commas in `summarize` aggregates and `by` keys, preserving `by = ...`.
mode: syntax
---- query
from t | summarize sum(amount), by customerId;
from t | summarize sum(amount) by customerId,;
from t | summarize total = sum(amount), count(), by customerId, country,;
from t | summarize sum(amount), by = count();
from t | summarize sum(amount), by = count(), by customerId,
---- expected
PROGRAM@0..275
  PIPELINE@0..45
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    SUMMARIZE_OP@9..45
      IDENT@9..18 "summarize"
      WHITESPACE@18..19 " "
      NAMED_EXPR@19..30
        CALL_EXPR@19..30
          NAME_REF@19..22
            IDENT@19..22 "sum"
          ARG_LIST@22..30
            L_PAREN@22..23 "("
            NAME_REF@23..29
              IDENT@23..29 "amount"
            R_PAREN@29..30 ")"
      COMMA@30..31 ","
      WHITESPACE@31..32 " "
      BY_CLAUSE@32..45
        IDENT@32..34 "by"
        WHITESPACE@34..35 " "
        NAMED_EXPR@35..45
          NAME_REF@35..45
            IDENT@35..45 "customerId"
  SEMICOLON@45..46 ";"
