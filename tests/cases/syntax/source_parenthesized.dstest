# A parenthesized pipeline as a source, and a quoted name.
mode: syntax
---- query
('orders.csv' | take 5) | union ['my table']
---- expected
PROGRAM@0..45
  PIPELINE@0..44
    PAREN_EXPR@0..23
      L_PAREN@0..1 "("
      PIPELINE@1..22
        LITERAL@1..13
          STRING@1..13 "'orders.csv'"
        WHITESPACE@13..14 " "
        PIPE@14..15 "|"
        WHITESPACE@15..16 " "
        TAKE_OP@16..22
          IDENT@16..20 "take"
          WHITESPACE@20..21 " "
          LITERAL@21..22
            LONG@21..22 "5"
      R_PAREN@22..23 ")"
    WHITESPACE@23..24 " "
    PIPE@24..25 "|"
    WHITESPACE@25..26 " "
    UNION_OP@26..44
      IDENT@26..31 "union"
      WHITESPACE@31..32 " "
      NAME_REF@32..44
        QUOTED_IDENT@32..44 "['my table']"
  WHITESPACE@44..45 "\n"
