# A parenthesized pipeline as a source, and a quoted name.
mode: syntax
---- query
(from 'orders.csv' | take 5) | union ['my table']
---- expected
PROGRAM@0..50
  PIPELINE@0..49
    PAREN_EXPR@0..28
      L_PAREN@0..1 "("
      PIPELINE@1..27
        IDENT@1..5 "from"
        WHITESPACE@5..6 " "
        LITERAL@6..18
          STRING@6..18 "'orders.csv'"
        WHITESPACE@18..19 " "
        PIPE@19..20 "|"
        WHITESPACE@20..21 " "
        TAKE_OP@21..27
          IDENT@21..25 "take"
          WHITESPACE@25..26 " "
          LITERAL@26..27
            LONG@26..27 "5"
      R_PAREN@27..28 ")"
    WHITESPACE@28..29 " "
    PIPE@29..30 "|"
    WHITESPACE@30..31 " "
    UNION_OP@31..49
      IDENT@31..36 "union"
      WHITESPACE@36..37 " "
      NAME_REF@37..49
        QUOTED_IDENT@37..49 "['my table']"
  WHITESPACE@49..50 "\n"
