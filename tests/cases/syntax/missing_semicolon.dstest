# New statements on new lines without ; (DS0106, with a fix that inserts it).
mode: syntax
---- query
let x = 5
from t | take x
from u | take 3
---- expected
PROGRAM@0..42
  LET_STMT@0..9
    LET_KW@0..3 "let"
    WHITESPACE@3..4 " "
    NAME@4..5
      IDENT@4..5 "x"
    WHITESPACE@5..6 " "
    EQ@6..7 "="
    WHITESPACE@7..8 " "
    LITERAL@8..9
      LONG@8..9 "5"
  WHITESPACE@9..10 "\n"
  PIPELINE@10..25
    IDENT@10..14 "from"
    WHITESPACE@14..15 " "
    NAME_REF@15..16
      IDENT@15..16 "t"
    WHITESPACE@16..17 " "
    PIPE@17..18 "|"
    WHITESPACE@18..19 " "
    TAKE_OP@19..25
      IDENT@19..23 "take"
      WHITESPACE@23..24 " "
      NAME_REF@24..25
        IDENT@24..25 "x"
  WHITESPACE@25..26 "\n"
  PIPELINE@26..41
    IDENT@26..30 "from"
    WHITESPACE@30..31 " "
    NAME_REF@31..32
      IDENT@31..32 "u"
    WHITESPACE@32..33 " "
    PIPE@33..34 "|"
    WHITESPACE@34..35 " "
    TAKE_OP@35..41
      IDENT@35..39 "take"
      WHITESPACE@39..40 " "
      LITERAL@40..41
        LONG@40..41 "3"
  WHITESPACE@41..42 "\n"

error[DS0106]: missing `;` between statements
  --> query:1:10
  |
1 | let x = 5
  |          ^ expected `;` here
2 | from t | take x
  | ---- a new statement starts here
  |
  = help: end the statement with `;`

error[DS0106]: missing `;` between statements
  --> query:2:16
  |
2 | from t | take x
  |                ^ expected `;` here
3 | from u | take 3
  | ---- a new statement starts here
  |
  = help: end the statement with `;`

with the machine-applicable fixes applied:
    let x = 5;
    from t | take x;
    from u | take 3
which parses without errors
