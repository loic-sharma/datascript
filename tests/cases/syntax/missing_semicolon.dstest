# New statements on new lines without ; (DS0106, with a fix that inserts it).
mode: syntax
---- query
let x = 5
t | take x
u | take 3
---- expected
PROGRAM@0..32
  LET_STMT@0..9
    LET_KW@0..3 "let"
    WHITESPACE@3..4 " "
    NAME@4..5
      IDENT@4..5 "x"
    WHITESPACE@5..6 " "
    EQ@6..7 "="
    WHITESPACE@7..8 " "
    LITERAL@8..9
      LONG@8..9 "5"
  WHITESPACE@9..10 "\n"
  PIPELINE@10..20
    NAME_REF@10..11
      IDENT@10..11 "t"
    WHITESPACE@11..12 " "
    PIPE@12..13 "|"
    WHITESPACE@13..14 " "
    TAKE_OP@14..20
      IDENT@14..18 "take"
      WHITESPACE@18..19 " "
      NAME_REF@19..20
        IDENT@19..20 "x"
  WHITESPACE@20..21 "\n"
  PIPELINE@21..31
    NAME_REF@21..22
      IDENT@21..22 "u"
    WHITESPACE@22..23 " "
    PIPE@23..24 "|"
    WHITESPACE@24..25 " "
    TAKE_OP@25..31
      IDENT@25..29 "take"
      WHITESPACE@29..30 " "
      LITERAL@30..31
        LONG@30..31 "3"
  WHITESPACE@31..32 "\n"

error[DS0106]: missing `;` between statements
  --> query:1:10
  |
1 | let x = 5
  |          ^ expected `;` here
2 | t | take x
  | - a new statement starts here
  |
  = help: end the statement with `;`

error[DS0106]: missing `;` between statements
  --> query:2:11
  |
2 | t | take x
  |           ^ expected `;` here
3 | u | take 3
  | - a new statement starts here
  |
  = help: end the statement with `;`

with the machine-applicable fixes applied:
    let x = 5;
    t | take x;
    u | take 3
which parses without errors
