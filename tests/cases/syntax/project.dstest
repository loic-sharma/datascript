        WHITESPACE@22..23 " "
        BIN_EXPR@23..28
          NAME_REF@23..24
            IDENT@23..24 "a"
          WHITESPACE@24..25 " "
          PLUS@25..26 "+"
          WHITESPACE@26..27 " "
          NAME_REF@27..28
            IDENT@27..28 "b"
      COMMA@28..29 ","
      WHITESPACE@29..30 " "
      NAMED_EXPR@30..41
        NAME@30..37
