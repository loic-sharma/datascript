# project selects, renames and computes.
mode: syntax
---- query
t | project a, total = a + b, ['x y'] = c
---- expected
PROGRAM@0..42
  PIPELINE@0..41
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    PROJECT_OP@4..41
      IDENT@4..11 "project"
      WHITESPACE@11..12 " "
