# top takes a count and one sort key.
mode: syntax
---- query
from t | top 10 by revenue desc
---- expected
PROGRAM@0..32
  PIPELINE@0..31
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    TOP_OP@9..31
      IDENT@9..12 "top"
      WHITESPACE@12..13 " "
      LITERAL@13..15
        LONG@13..15 "10"
      WHITESPACE@15..16 " "
      IDENT@16..18 "by"
      WHITESPACE@18..19 " "
      SORT_KEY@19..31
        NAME_REF@19..26
          IDENT@19..26 "revenue"
        WHITESPACE@26..27 " "
        IDENT@27..31 "desc"
  WHITESPACE@31..32 "\n"
