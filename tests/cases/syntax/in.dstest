              ARG_LIST@15..24
                L_PAREN@15..16 "("
                LITERAL@16..17
                  LONG@16..17 "1"
                COMMA@17..18 ","
                WHITESPACE@18..19 " "
                LITERAL@19..20
                  LONG@19..20 "2"
                COMMA@20..21 ","
                WHITESPACE@21..22 " "
                LITERAL@22..23
                  LONG@22..23 "3"
                R_PAREN@23..24 ")"
            WHITESPACE@24..25 " "
            AND_KW@25..28 "and"
            WHITESPACE@28..29 " "
            IN_EXPR@29..40
              NAME_REF@29..30
                IDENT@29..30 "b"
              WHITESPACE@30..31 " "
              NEGATED_OP@31..34 "!in"
              WHITESPACE@34..35 " "
              ARG_LIST@35..40
                L_PAREN@35..36 "("
                LITERAL@36..39
