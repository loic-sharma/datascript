# in, !in, in~ and !in~ take a parenthesized list.
mode: syntax
---- query
from t | where a in (1, 2, 3) and b !in ('x') and c in~ ('A', 'b') and d !in~ ('c')
---- expected
PROGRAM@0..84
  PIPELINE@0..83
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    WHERE_OP@9..83
