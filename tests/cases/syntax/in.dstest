              WHITESPACE@16..17 " "
              IDENT@17..19 "in"
              WHITESPACE@19..20 " "
              ARG_LIST@20..29
                L_PAREN@20..21 "("
                LITERAL@21..22
                  LONG@21..22 "1"
                COMMA@22..23 ","
                WHITESPACE@23..24 " "
                LITERAL@24..25
                  LONG@24..25 "2"
                COMMA@25..26 ","
                WHITESPACE@26..27 " "
                LITERAL@27..28
                  LONG@27..28 "3"
                R_PAREN@28..29 ")"
            WHITESPACE@29..30 " "
            AND_KW@30..33 "and"
            WHITESPACE@33..34 " "
            IN_EXPR@34..45
              NAME_REF@34..35
                IDENT@34..35 "b"
              WHITESPACE@35..36 " "
              NEGATED_OP@36..39 "!in"
              WHITESPACE@39..40 " "
              ARG_LIST@40..45
                L_PAREN@40..41 "("
                LITERAL@41..44
