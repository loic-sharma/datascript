          WHITESPACE@45..46 " "
          AND_KW@46..49 "and"
          WHITESPACE@49..50 " "
          IN_EXPR@50..66
            NAME_REF@50..51
              IDENT@50..51 "c"
            WHITESPACE@51..52 " "
            IN_TILDE@52..55 "in~"
            WHITESPACE@55..56 " "
            ARG_LIST@56..66
              L_PAREN@56..57 "("
