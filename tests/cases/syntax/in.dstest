          WHITESPACE@44..45 " "
          IN_EXPR@45..61
            NAME_REF@45..46
              IDENT@45..46 "c"
            WHITESPACE@46..47 " "
            IN_TILDE@47..50 "in~"
            WHITESPACE@50..51 " "
            ARG_LIST@51..61
              L_PAREN@51..52 "("
              LITERAL@52..55
                STRING@52..55 "'A'"
              COMMA@55..56 ","
