# summarize with only by keys returns the distinct keys.
mode: syntax
---- query
from t | summarize by customerId
---- expected
PROGRAM@0..33
  PIPELINE@0..32
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..6
      IDENT@5..6 "t"
    WHITESPACE@6..7 " "
    PIPE@7..8 "|"
    WHITESPACE@8..9 " "
    SUMMARIZE_OP@9..32
      IDENT@9..18 "summarize"
      WHITESPACE@18..19 " "
      BY_CLAUSE@19..32
        IDENT@19..21 "by"
        WHITESPACE@21..22 " "
        NAMED_EXPR@22..32
          NAME_REF@22..32
            IDENT@22..32 "customerId"
  WHITESPACE@32..33 "\n"
