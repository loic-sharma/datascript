# summarize with only by keys returns the distinct keys.
mode: syntax
---- query
t | summarize by customerId
---- expected
PROGRAM@0..28
  PIPELINE@0..27
    NAME_REF@0..1
      IDENT@0..1 "t"
    WHITESPACE@1..2 " "
    PIPE@2..3 "|"
    WHITESPACE@3..4 " "
    SUMMARIZE_OP@4..27
      IDENT@4..13 "summarize"
      WHITESPACE@13..14 " "
      BY_CLAUSE@14..27
        IDENT@14..16 "by"
        WHITESPACE@16..17 " "
        NAMED_EXPR@17..27
          NAME_REF@17..27
            IDENT@17..27 "customerId"
  WHITESPACE@27..28 "\n"
