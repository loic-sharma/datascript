# Compressed and JSON files read the same rows as their plain forms.
mode: run
---- query
from '../../data/compressed/orders.csv.gz' | where orderId == 'o-0029';
from '../../data/compressed/orders.tsv.zst' | where orderId == 'o-0030';
from '../../data/json/array.json';
from '../../data/json/lines.json'
