# NDJSON glob: merges schemas by name across files. `country` exists only in February (null
# in January and March), and March has a null `duration_ms`.
mode: run
---- query
from '../../data/events/*.ndjson'
| project ts, user, event, duration_ms, country
| sort by ts asc;
from '../../data/events/*.ndjson'
| summarize events = count(), with_country = countif(isnotnull(country)), with_duration = countif(isnotnull(duration_ms));
from '../../data/**/2024-0?.ndjson'
| count
