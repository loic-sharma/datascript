# `read_parquet` called as a function: direct path, `let`-bound path, and widened Parquet types.
mode: run
---- query
let p = '../../data/orders.parquet';
from read_parquet('../../data/orders.parquet')
| where orderId == 'o-0001';
from read_parquet(p)
| count;
from read_parquet('../../data/types.parquet')
| project id, i16, u32, dict
| sort by id asc
