# Sample `explain` case: prints the logical plan.
# The plan format is defined by M1-06, which re-blesses this file if it changes.
mode: explain
schema: orders(orderId: string, customerId: string, amount: real, timestamp: datetime)
---- query
from orders | where amount > 10 | take 5
---- expected
Limit: 5
  Filter: amount > 10.0
    Scan: table `orders` (orderId: string, customerId: string, amount: real, timestamp: datetime)
