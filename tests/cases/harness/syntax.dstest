# Sample `syntax` case: dumps the CST of a short pipeline.
mode: syntax
---- query
from orders | where amount > 10 | take 5
---- expected
PROGRAM@0..41
  PIPELINE@0..40
    IDENT@0..4 "from"
    WHITESPACE@4..5 " "
    NAME_REF@5..11
      IDENT@5..11 "orders"
    WHITESPACE@11..12 " "
    PIPE@12..13 "|"
    WHITESPACE@13..14 " "
    WHERE_OP@14..31
      IDENT@14..19 "where"
      WHITESPACE@19..20 " "
      BIN_EXPR@20..31
        NAME_REF@20..26
          IDENT@20..26 "amount"
        WHITESPACE@26..27 " "
        GT@27..28 ">"
        WHITESPACE@28..29 " "
        LITERAL@29..31
          LONG@29..31 "10"
    WHITESPACE@31..32 " "
    PIPE@32..33 "|"
    WHITESPACE@33..34 " "
    TAKE_OP@34..40
      IDENT@34..38 "take"
      WHITESPACE@38..39 " "
      LITERAL@39..40
        LONG@39..40 "5"
  WHITESPACE@40..41 "\n"
